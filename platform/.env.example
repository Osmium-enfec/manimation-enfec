# Copy this file to .env and add your key:
#   cp platform/.env.example platform/.env
#
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Max number of Manim renders allowed to run at once. Each render is a heavy
# subprocess (~0.5-1+ GB RAM), so this caps memory use under concurrent load.
# Extra renders queue instead of piling up. Tune to your server's RAM.
MAX_CONCURRENT_RENDERS=2
